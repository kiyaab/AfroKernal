# =================================================================
# AfroKernal Environment Variables Configuration Template
# =================================================================

# Native PostgreSQL & Prisma Database URL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/afrokernel?schema=public"

# Session & Authentication Secret
SESSION_SECRET="afrokernel_production_session_secret_change_me"

# Server Port (optional, default: 3000)
PORT=3000
HOST=0.0.0.0

# Google OAuth 2.0 Client ID (from Google Cloud Console)
VITE_GOOGLE_CLIENT_ID="984055852217-7tlhvji1ggtbirmcbgre2jqat889dh2a.apps.googleusercontent.com"

# Real Gmail / Google Workspace SMTP Email OTP Configuration
# Generate 16-character App Password at: https://myaccount.google.com/apppasswords
GMAIL_USER="your-email@gmail.com"
GMAIL_APP_PASSWORD="your-google-app-password"

# Optional Custom SMTP Server (if not using direct Gmail SMTP)
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT=465
# SMTP_USER="your-email@gmail.com"
# SMTP_PASS="your-google-app-password"
