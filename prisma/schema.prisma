// ─── AFROKERNEL DATABASE SCHEMA (PRISMA) ─────────────────────────
// Complete native PostgreSQL data layer for AfroKernel,
// replacing Supabase with Prisma ORM for all authentication,
// user management, course curriculum, quizzes, labs, and AI tutor features.

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ─── USERS & AUTHENTICATION ──────────────────────────────────────
model User {
  id            String    @id @default(uuid()) @db.Uuid
  email         String    @unique
  passwordHash  String?   @map("password_hash")
  displayName   String?   @map("display_name")
  avatarUrl     String?   @map("avatar_url")
  role          String    @default("user") // "admin", "instructor", "user"
  emailVerified Boolean   @default(false) @map("email_verified")
  authProvider  String    @default("email") @map("auth_provider") // "email" | "google"
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  profile       Profile?
  sessions      Session[]
  userRoles     UserRole[]
  userStats     UserStats?

  @@map("users")
}

model Session {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  token        String   @unique
  expiresAt    DateTime @map("expires_at")
  createdAt    DateTime @default(now()) @map("created_at")
  lastActiveAt DateTime @default(now()) @map("last_active_at")

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model UserRole {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  role      String   // "admin", "instructor", "student", "user"
  createdAt DateTime @default(now()) @map("created_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
  @@map("user_roles")
}

model UserStats {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @unique @map("user_id") @db.Uuid
  xp           Int      @default(0)
  level        Int      @default(1)
  streakDays   Int      @default(0) @map("streak_days")
  lastActiveAt DateTime @default(now()) @map("last_active_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_stats")
}

// ─── PROFILES ─────────────────────────────────────────────────────
model Profile {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @unique @map("user_id") @db.Uuid
  displayName     String?  @map("display_name")
  avatarUrl       String?  @map("avatar_url")
  bio             String?
  headline        String?
  location        String?
  website         String?
  githubUrl       String?  @map("github_url")
  learningGoal    String?  @map("learning_goal")
  preferredDistro String?  @map("preferred_distro")
  xp              Int      @default(0)
  level           Int      @default(1)
  streakDays      Int      @default(0) @map("streak_days")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  enrollments       Enrollment[]
  lessonProgress    LessonProgress[]
  challengeAttempts ChallengeAttempt[]
  examSubmissions   ExamSubmission[]
  chatConversations ChatConversation[]

  @@map("profiles")
}

// ─── COURSES ───────────────────────────────────────────────────────
model Course {
  id           String   @id @default(uuid()) @db.Uuid
  slug         String   @unique
  title        String
  subtitle     String?
  description  String   @default("") @db.Text
  category     String   @default("Fundamentals") // "Fundamentals", "Enterprise Linux", "Scripting", "Networking"
  difficulty   String   @default("beginner") // "beginner", "intermediate", "advanced"
  coverUrl     String?  @map("cover_url")
  duration     Float    @default(0) // Duration in hours
  rating       Float    @default(5.0)
  reviewCount  Int      @default(0) @map("review_count")
  learnerCount Int      @default(0) @map("learner_count")
  featured     Boolean  @default(false)
  published    Boolean  @default(true)
  sortOrder    Int      @default(0) @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  lessons     Lesson[]
  enrollments Enrollment[]

  @@map("courses")
}

// ─── LESSONS ───────────────────────────────────────────────────────
model Lesson {
  id              String   @id @default(uuid()) @db.Uuid
  courseId        String   @map("course_id") @db.Uuid
  slug            String
  title           String
  lessonType      String   @default("notes") @map("lesson_type") // "video", "notes", "lab", "quiz"
  videoUrl        String?  @map("video_url")
  pdfUrl          String?  @map("pdf_url")
  starterCode     String?  @map("starter_code")
  durationMinutes Int      @default(15) @map("duration_minutes")
  xpReward        Int      @default(20) @map("xp_reward")
  sortOrder       Int      @default(0) @map("sort_order")
  contentMarkdown String   @default("") @map("content_markdown") @db.Text
  published       Boolean  @default(true)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  course          Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  progress        LessonProgress[]
  challenge       Challenge?

  @@unique([courseId, slug])
  @@map("lessons")
}

// ─── LAB CHALLENGES ───────────────────────────────────────────────
model Challenge {
  id             String   @id @default(uuid()) @db.Uuid
  lessonId       String   @unique @map("lesson_id") @db.Uuid
  title          String
  prompt         String   @db.Text
  starterCommand String?  @map("starter_command")
  expectedOutput String   @map("expected_output") @db.Text
  matchMode      String   @default("exact") @map("match_mode") // "exact", "regex", "contains"
  xpReward       Int      @default(25) @map("xp_reward")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  lesson         Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  attempts       ChallengeAttempt[]

  @@map("challenges")
}

model ChallengeAttempt {
  id          String   @id @default(uuid()) @db.Uuid
  challengeId String   @map("challenge_id") @db.Uuid
  profileId   String   @map("profile_id") @db.Uuid
  output      String   @db.Text
  passed      Boolean
  awardedXp   Int      @default(0) @map("awarded_xp")
  createdAt   DateTime @default(now()) @map("created_at")

  challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  profile     Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@map("challenge_attempts")
}

// ─── USER ENROLLMENTS & LESSON PROGRESS ───────────────────────────
model Enrollment {
  id         String   @id @default(uuid()) @db.Uuid
  profileId  String   @map("profile_id") @db.Uuid
  courseId   String   @map("course_id") @db.Uuid
  enrolledAt DateTime @default(now()) @map("enrolled_at")

  profile    Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([profileId, courseId])
  @@map("enrollments")
}

model LessonProgress {
  id          String    @id @default(uuid()) @db.Uuid
  profileId   String    @map("profile_id") @db.Uuid
  lessonId    String    @map("lesson_id") @db.Uuid
  completed   Boolean   @default(false)
  score       Int?      @default(100)
  completedAt DateTime? @map("completed_at")

  profile     Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  lesson      Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([profileId, lessonId])
  @@map("lesson_progress")
}

// ─── PRACTICE EXAM SUBMISSIONS ────────────────────────────────────
model ExamSubmission {
  id             String   @id @default(uuid()) @db.Uuid
  profileId      String   @map("profile_id") @db.Uuid
  trackId        String   @map("track_id")
  trackLabel     String   @map("track_label")
  score          Int
  totalQuestions Int      @map("total_questions")
  percentage     Float
  passed         Boolean
  answersJson    Json?    @map("answers_json")
  submittedAt    DateTime @default(now()) @map("submitted_at")

  profile        Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@map("exam_submissions")
}

// ─── AI LINUX TUTOR CHAT ──────────────────────────────────────────
model ChatConversation {
  id        String        @id @default(uuid()) @db.Uuid
  profileId String        @map("profile_id") @db.Uuid
  title     String        @default("New Chat")
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  profile   Profile       @relation(fields: [profileId], references: [id], onDelete: Cascade)
  messages  ChatMessage[]

  @@map("chat_conversations")
}

model ChatMessage {
  id             String           @id @default(uuid()) @db.Uuid
  conversationId String           @map("conversation_id") @db.Uuid
  role           String           // "user" | "assistant" | "system"
  content        String           @db.Text
  createdAt      DateTime         @default(now()) @map("created_at")

  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@map("chat_messages")
}

// ─── QUIZZES & ASSESSMENT ─────────────────────────────────────────
model Quiz {
  id           String   @id @default(uuid()) @db.Uuid
  lessonId     String   @unique @map("lesson_id") @db.Uuid
  title        String
  description  String?
  passingScore Int      @default(70) @map("passing_score")
  xpReward     Int      @default(25) @map("xp_reward")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  questions    QuizQuestion[]

  @@map("quizzes")
}

model QuizQuestion {
  id           String   @id @default(uuid()) @db.Uuid
  quizId       String   @map("quiz_id") @db.Uuid
  prompt       String
  choices      Json     // list of strings: ["choice 1", "choice 2"]
  correctIndex Int      @map("correct_index")
  explanation  String?
  sortOrder    Int      @default(0) @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at")

  quiz         Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@map("quiz_questions")
}

model WeeklyGoal {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  weekStart        String   @map("week_start")
  targetXp         Int      @default(500) @map("target_xp")
  earnedXp         Int      @default(0) @map("earned_xp")
  remindersEnabled Boolean  @default(true) @map("reminders_enabled")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@unique([userId, weekStart])
  @@map("weekly_goals")
}

// ─── LINUX COMMANDS REFERENCE (DOCS) ──────────────────────────────
model LinuxCommand {
  id           String   @id @default(uuid()) @db.Uuid
  slug         String   @unique
  name         String
  category     String
  shortDesc    String   @map("short_desc")
  syntax       String
  examplesJson Json     @map("examples_json")
  mistakesJson Json?    @map("mistakes_json")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("linux_commands")
}
